# If the server is unavalable perform all the following commands.

# Remove my APT repository on that server from my apt sources.
rm -f /etc/apt/sources.list.d/hermes.sources

# Official and third-party source lists.
cp /etc/dosab/debian.sources.unavailable /etc/apt/sources.list.d/debian.sources
cp /etc/dosab/obs.sources.unavailable /etc/apt/sources.list.d/obs.sources

