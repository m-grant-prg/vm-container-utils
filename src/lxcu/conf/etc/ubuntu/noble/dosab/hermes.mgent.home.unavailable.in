# If the server is unavalable perform all the following commands.

# Remove my APT repository on that server from my apt sources.
rm -f /etc/apt/sources.list.d/hermes.sources

# Dis-allow apt caching on that server
cp /etc/dosab/launchpad.sources.unavailable /etc/apt/sources.list.d/launchpad.sources
cp /etc/dosab/ubuntu.sources.unavailable /etc/apt/sources.list/ubuntu.sources

